# ── LLM Provider Configuration ──
# Supported values: mock | deepseek | openai
# mock = demo mode, no API key needed
# deepseek = DeepSeek API (OpenAI-compatible)
LLM_PROVIDER=mock

# OpenAI-compatible API base URL
# DeepSeek: https://api.deepseek.com
# OpenAI:  https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# Your API key (NOT shared, keep secret)
LLM_API_KEY=

# Model selection
# ANALYSIS_MODEL: used for portrait report and style card generation
# CHAT_MODEL:     used for real-time chat replies
# DeepSeek models: deepseek-chat, deepseek-reasoner
ANALYSIS_MODEL=deepseek-chat
CHAT_MODEL=deepseek-chat

# LLM call parameters
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── MinerU Document Parsing ──
# MinerU converts PDF/DOCX/PPTX/XLSX/images to Markdown for RAG & analysis
# Install: powershell -ExecutionPolicy Bypass -File scripts/install_mineru_windows.ps1
# Check status: GET /api/integrations/mineru/status
MINERU_ENABLED=true
# Backend: pipeline (faster, recommended) | hybrid-auto-engine (stronger, slower)
MINERU_BACKEND=pipeline
# Method: auto | ocr | txt
MINERU_METHOD=auto
# Language: ch | en
MINERU_LANG=ch
# Page range (optional, 1-based): set to test first few pages before full parse
# MINERU_START_PAGE=1
# MINERU_END_PAGE=5
MINERU_FORMULA=true
MINERU_TABLE=true
# Image analysis: off by default — enable only for image-heavy documents
MINERU_IMAGE_ANALYSIS=false
MINERU_TIMEOUT_SECONDS=300
MINERU_OUTPUT_DIR=../data/mineru_output

# ── mem0 Long-term Memory (OPTIONAL) ──
# mem0 provides persistent cross-session memory for AI applications.
# Install: pip install mem0ai
# When disabled (default), the project uses SQLite chat_messages for short-term history.
MEM0_ENABLED=false
MEM0_PROVIDER=local
MEM0_COLLECTION_PREFIX=ai_clone_profile

# ── Application Settings ──
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=../data
