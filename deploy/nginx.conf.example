server {
    listen 80;
    listen [::]:80;
    server_name echo.example.com;

    root /opt/ai_clone/frontend/dist;
    index index.html;

    client_max_body_size 25M;

    # Optional Basic Auth. Enable this for resume/demo deployments to protect API quota.
    # Create password file:
    #   sudo apt install apache2-utils
    #   sudo htpasswd -c /etc/nginx/.htpasswd echo
    #
    # auth_basic "Echo Profile";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    # Never expose private project files or runtime data.
    location ~* (^|/)(\.env|\.git|data|uploads|generated_skills)(/|$) {
        deny all;
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
